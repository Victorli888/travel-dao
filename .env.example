# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here

# Google OAuth — from https://console.cloud.google.com/
AUTH_GOOGLE_ID=your_google_client_id_here
AUTH_GOOGLE_SECRET=your_google_client_secret_here

# Email sign-in codes — https://resend.com. Leave both blank in development
# and the code is printed to the dev-server console instead. Production
# refuses to send codes without them. MAIL_FROM must be on a verified domain.
RESEND_API_KEY=
MAIL_FROM=Travel Tao <sign-in@your-domain.example>

# Anthropic — used for trip place research
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Neon Postgres connection string — from console.neon.tech
DATABASE_URL=postgresql://user:password@host/dbname

# Local Postgres DB
LOCAL_DATABASE_URL=postgresql://user:password@host/dbname

# Optional. Set to run the live itinerary tests in lib/itinerary/crud.test.ts;
# leaving it blank skips them and `npm test` stays database-free. Point it at a
# Neon database — @neondatabase/serverless speaks HTTP, not the Postgres wire
# protocol, so LOCAL_DATABASE_URL will not work here.
TEST_DATABASE_URL=
